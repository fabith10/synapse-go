{
  "active_provider": "mock",
  "deferral_policy": {
    "enabled": true,
    "bypass_all": false,
    "cost_threshold_usd": 1.0,
    "token_threshold": 50000,
    "peak_start_hour_utc": 0,
    "peak_end_hour_utc": 23
  },
  "providers": {
    "coingecko": {
      "type": "coingecko",
      "description": "Live Ethereum benchmark spot price index from CoinGecko API",
      "api_url": "https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd"
    },
    "custom_http": {
      "type": "custom_http",
      "description": "External custom HTTP compute pricing API",
      "base_url": "https://api.example.com",
      "api_key_env": "PRICING_API_KEY"
    },
    "mock": {
      "type": "mock",
      "description": "Internal mock compute pricing and task execution endpoints",
      "base_url": "http://localhost:8080"
    },
    "static_json": {
      "type": "static_json",
      "description": "Local workspace static JSON pricing matrix",
      "file_path": "pricing_matrix.json"
    },
    "free_live": {
      "type": "free_live",
      "description": "Composite free-tier live real-world pricing feed (OpenRouter + Vast.ai + Deribit)"
    },
    "openrouter": {
      "type": "openrouter",
      "description": "OpenRouter free public models pricing API"
    },
    "vastai": {
      "type": "vastai",
      "description": "Vast.ai free public GPU spot offers feed"
    },
    "deribit": {
      "type": "deribit",
      "description": "Deribit free public forward curve and volatility structure"
    },
    "declarative_live": {
      "type": "declarative_http",
      "description": "100% Declarative Zero-Code Live Pricing Provider",
      "base_url": "https://vast.ai/api/v0",
      "endpoints": {
        "spot": {
          "path": "/bundles/"
        }
      },
      "mappings": {
        "spot_rate_path": "offers.dph_total",
        "array_match_key": "gpu_name",
        "static_matrix": {
          "H100_SXM": 2.49,
          "RTX_4090": 0.45,
          "A100_80GB": 1.29
        }
      }
    }
  }
}
