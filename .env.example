# =========================================================================
# Template Environment Configuration for Agentic Framework
# =========================================================================
# Rename this file to '.env' and fill in your keys.
# NEVER commit the '.env' file containing your actual credentials.
# =========================================================================

# API key for the Tavily web search tool (Deep Researcher agent)
# Get a free key at https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# API key for commercial OpenAI models (e.g. gpt-4o)
# Get a key at https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# API key for commercial Anthropic models (if used)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API key for commercial Gemini models (if used)
# GEMINI_API_KEY=your_gemini_api_key_here

# Pricing Oracle dynamic provider selection ('mock', 'coingecko', 'custom_http', 'static_json')
PRICING_PROVIDER=mock

# Optional custom Pricing Oracle API URL override
# PRICING_ORACLE_URL=http://localhost:8080

# Optional authentication key for custom pricing provider
# PRICING_API_KEY=your_pricing_api_key_here
