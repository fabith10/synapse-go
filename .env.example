# =============================================================================
# Agent Framework — Environment Variable Reference
# =============================================================================
# Rename this file to '.env' and fill in your values for local development.
# NEVER commit the actual '.env' file — it is listed in .gitignore.
# For production deployments, inject variables via your platform's secret
# manager (Kubernetes Secrets, AWS ECS env, GCP Secret Manager, etc.).
# =============================================================================


# =============================================================================
# SECTION 1 — LLM Provider API Keys (Required: at least one)
# =============================================================================

# Gemini API key for Google Generative AI models (e.g. gemini-2.0-flash)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key for GPT models (e.g. gpt-4o, gpt-4o-mini)
# Get a key at https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key for Claude models (e.g. claude-3-5-sonnet)
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Additional provider keys are loaded dynamically from models.json.
# The 'apiKeyEnv' field in each provider entry sets the env var name to read.


# =============================================================================
# SECTION 2 — Tool API Keys (Optional)
# =============================================================================

# Tavily API key for the web search / deep research tool (researcher-agent)
# Get a free key at https://tavily.com/
# TAVILY_API_KEY=your_tavily_api_key_here

# API key for the custom HTTP pricing oracle provider (custom_http adapter)
# The env var name can be overridden per-provider via 'api_key_env' in
# pricing_providers.json. Defaults to PRICING_API_KEY.
# PRICING_API_KEY=your_pricing_api_key_here


# =============================================================================
# SECTION 3 — Web Server
# =============================================================================

# HTTP port the control panel dashboard listens on.
# Default: 8080
# PORT=8080

# Network interface to bind the web server to.
# Default: 127.0.0.1 (localhost only — recommended for local dev).
# Set to 0.0.0.0 ONLY when deliberately exposing the dashboard to the network
# (e.g. behind a reverse proxy / in a container). No auth is added by default.
# BIND_ADDR=127.0.0.1

# Allowed origin for CORS on the SSE /stream/logs endpoint.
# Leave unset to disable CORS (same-origin dashboard access only).
# Set to a specific origin when running the dashboard frontend on a separate port.
# CORS_ALLOW_ORIGIN=http://localhost:3000


# =============================================================================
# SECTION 4 — Database
# =============================================================================

# SQLite database connection string.
# Supports in-memory DSN (file::memory:?cache=shared) for ephemeral test runs.
# Default: agent_framework.db (file in the working directory)
# SQLITE_DSN=agent_framework.db


# =============================================================================
# SECTION 5 — Pricing Oracle
# =============================================================================

# Active pricing provider. Controls which adapter the Pricing Oracle uses.
# Choices: mock | coingecko | custom_http | static_json
# Default: mock
PRICING_PROVIDER=mock

# Base URL for the custom HTTP pricing oracle API (custom_http adapter).
# Overrides 'base_url' in pricing_providers.json when set.
# PRICING_ORACLE_URL=http://localhost:8081

# Force all Pricing Oracle task requests to be treated as URGENT, bypassing
# the off-peak deferral scheduler. Useful for development and demos.
# Values: true | (unset)
# FORCE_URGENT=true

# Bypass the off-peak deferral scheduler entirely (all tasks run immediately).
# Values: true | (unset)
# DEFERRAL_BYPASS=true

# Mock mode aliases — any of these flags causes a system warning to appear
# in the dashboard indicating the framework is running in simulation mode.
# USE_MOCK_PRICING=true
# MOCK_PRICING=true
# USE_MOCK_MODELS=true
# MOCK_MODELS=true
# MOCK_LLM=true
# USE_MOCK_TOOLS=true
# MOCK_TOOLS=true
# MOCK_COMPUTE=true


# =============================================================================
# SECTION 6 — Ollama (Local / Open-Weight Models)
# =============================================================================

# Base URL for the Ollama daemon used for local model inference and
# the semantic injection guardrail classifier.
# Default: http://127.0.0.1:11434
# OLLAMA_HOST=http://127.0.0.1:11434

# Model used by the semantic prompt injection guardrail classifier.
# Priority order (first non-empty wins):
#   OLLAMA_CLASSIFIER_MODEL > CLASSIFIER_MODEL > GUARDRAIL_MODEL > "llama3"
# OLLAMA_CLASSIFIER_MODEL=llama3
# CLASSIFIER_MODEL=llama3
# GUARDRAIL_MODEL=llama3

# Ollama model used for embedding generation (RAG pipeline).
# Default: nomic-embed-text
# EMBEDDING_MODEL=nomic-embed-text


# =============================================================================
# SECTION 7 — Browser Automation (browser-agent / chromedp)
# =============================================================================

# Launch the browser in headed (visible) mode instead of headless.
# Useful for debugging browser-agent tasks locally.
# Values: true | (unset — default headless)
# HEADED=true
# BROWSER_HEADED=true

# Set HEADLESS=false as an alternative way to force headed mode.
# HEADLESS=false

# HTTP/HTTPS proxy server for headless Chrome.
# BROWSER_PROXY=http://proxy.company.com:8080
# HTTP_PROXY=http://proxy.company.com:8080

# Path to a Chrome user data directory. Use to persist cookies/sessions
# across browser-agent runs (e.g. for pre-authenticated scraping sessions).
# BROWSER_USER_DATA_DIR=/path/to/chrome-profile


# =============================================================================
# SECTION 8 — Docker Sandbox (Tier 3 Code Execution)
# =============================================================================

# Allow sandboxed Docker containers to access the network.
# Default: unset (network disabled — NetworkMode=none for security).
# Set to true ONLY when the containerised workload explicitly needs internet
# access (e.g. pip install during a trusted, gated pipeline step).
# DOCKER_ALLOW_NETWORK=true


# =============================================================================
# SECTION 9 — Logging
# =============================================================================

# Minimum log level written to stdout and optionally to LOG_FILE.
# Values: debug | info | warn | error
# Default: info
# LOG_LEVEL=info

# Log output format.
# Values: text (human-readable) | json (structured, for log aggregators)
# Default: text
# LOG_FORMAT=text

# Optional file path to append logs to in addition to stdout.
# The file is created if it does not exist.
# LOG_FILE=logs/agent_framework.log


# =============================================================================
# SECTION 10 — Testing & Development Flags
# =============================================================================
# These variables are intended ONLY for automated test pipelines.
# Do NOT set them in a production .env — they disable safety guardrails.

# Puts the framework into testing mode:
#   - Skips hardware-tier routing (all agents run locally)
#   - Disables semantic guardrail classification (IsMalicious returns false)
#   - Disables auto-browser open on startup
#   - Required in combination with AGENT_FRAMEWORK_BYPASS_HITL to skip HITL
# Values: true | (unset)
# AGENT_FRAMEWORK_TESTING=true

# Bypasses Human-in-the-Loop (HITL) review for risky code execution.
# ONLY effective when AGENT_FRAMEWORK_TESTING=true is also set.
# Setting this variable alone in production has NO effect (by design).
# Values: true | (unset)
# AGENT_FRAMEWORK_BYPASS_HITL=true

# Suppress dashboard system warnings (e.g. missing API key notices).
# Any non-empty value suppresses all warnings.
# SUPPRESS_WARNINGS=1

# Override the off-peak delay duration in seconds for test scheduling.
# Used to speed up time-based scheduler tests without real wall-clock waits.
# OFF_PEAK_TEST_DELAY_SECS=1

# Enable verbose OpenTelemetry tracer debug output.
# Values: true | (unset)
# OTEL_TRACER_DEBUG=true
